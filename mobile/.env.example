# Backend base URL. Defaults: http://10.0.2.2:8000 (Android emulator), http://localhost:8000 (iOS sim / web).
# On a physical phone use your computer's LAN IP, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=

# RevenueCat PUBLIC SDK keys (Project settings > API keys). Safe to ship; the secret key stays on the backend.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Shown on the paywall (required by Apple for auto-renewing subscriptions).
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
