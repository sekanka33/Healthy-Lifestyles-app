# Copy to .env and fill in. NEVER commit a real .env file.
ENVIRONMENT=development
PUBLIC_API_URL=http://localhost:8000
APP_DEEP_LINK_BASE=healthylifestyles://
SUPPORT_EMAIL=support@example.com

DATABASE_URL=postgresql+psycopg://wellness:wellness@localhost:5432/wellness

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Email: smtp (dev, e.g. Mailpit on :1025) | resend (prod) | disabled
EMAIL_PROVIDER=smtp
EMAIL_FROM=Healthy Lifestyles <no-reply@example.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
RESEND_API_KEY=

# OpenWeather (https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# Google Calendar OAuth — see docs/calendar-setup.md (Web application client; redirect URI below must match)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth/callback

# RevenueCat — Project settings > API keys > Secret API key (v1, sk_...).
REVENUECAT_SECRET_API_KEY=
# Integrations > Webhooks: point it at {PUBLIC_API_URL}/api/v1/billing/webhooks/revenuecat and set the
# Authorization header to EXACTLY this value. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_PREMIUM_ENTITLEMENT=premium
